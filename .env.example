# --- Databáze -------------------------------------------------------------
POSTGRES_DB=fakturka
POSTGRES_USER=fakturka
POSTGRES_PASSWORD=change-me

# Port, na kterém běží PostgreSQL při lokálním vývoji (docker-compose.dev.yml).
POSTGRES_PORT=5432

# Připojení pro Prisma. Při lokálním vývoji míří na localhost,
# v Docker stacku si ho compose sestaví sám na hostitele "db".
DATABASE_URL="postgresql://fakturka:change-me@localhost:5432/fakturka?schema=public"

# --- Aplikace -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Port publikovaný na hostiteli.
APP_PORT=3000

# Rozhraní, na které se publikovaný port naváže (jen produkční compose).
# 127.0.0.1 = dostupné jen z hostitele, provoz jde přes nginx proxy manager.
# 0.0.0.0   = aplikace je vystavená přímo na veřejné rozhraní.
APP_BIND=127.0.0.1

# --- Přihlášení -----------------------------------------------------------
# Heslo do aplikace. Pokud zůstane prázdné, aplikace běží BEZ přihlášení
# a zobrazuje varovný pruh. V produkci vždy nastavte.
AUTH_PASSWORD=

# Náhodný klíč pro podpis session cookie. Vygenerujte například:
#   openssl rand -base64 32
# Při změně se odhlásí všechny relace.
AUTH_SECRET=

# Platnost přihlášení v hodinách (výchozí 720 = 30 dní).
AUTH_SESSION_HOURS=720
