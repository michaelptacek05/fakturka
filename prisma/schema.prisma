generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VatPayerStatus {
  NON_PAYER
  PAYER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
  OVERDUE
}

enum InvoiceAssetType {
  LOGO
  SIGNATURE
  STAMP
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  DONE
  CANCELLED
}

/// Sloupce nástěnky úkolů. Pořadí odpovídá pořadí sloupců zleva doprava.
enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model UserProfile {
  id             String           @id @default(cuid())
  displayName    String
  companyName    String?
  street         String
  city           String
  postalCode     String
  country        String           @default("Česká republika")
  ico            String           @db.VarChar(16)
  dic            String?          @db.VarChar(20)
  registryText   String?
  vatPayerStatus VatPayerStatus   @default(NON_PAYER)
  accountNumber  String
  bankCode       String           @db.VarChar(10)
  iban           String?
  swift          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  assets         InvoiceAsset[]
  clients        Client[]
  invoices       Invoice[]
  projects       Project[]
  sequences      InvoiceSequence[]
}

model Client {
  id            String        @id @default(cuid())
  profileId     String
  companyName   String?
  fullName      String?
  street        String
  city          String
  postalCode    String
  country       String        @default("Česká republika")
  ico           String?       @db.VarChar(16)
  dic           String?       @db.VarChar(20)
  email         String?
  phone         String?
  aresSyncedAt  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  invoices      Invoice[]
  profile       UserProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  projects      Project[]

  @@index([profileId])
  @@index([ico])
}

model InvoiceSequence {
  id          String       @id @default(cuid())
  profileId   String
  name        String       @default("Výchozí")
  format      String       @default("YYYYMM###")
  nextNumber  Int          @default(1)
  /// Období, ke kterému patří nextNumber. Při změně období se řada resetuje.
  periodKey   String       @default("")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  invoices    Invoice[]
  profile     UserProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Invoice {
  id                String           @id @default(cuid())
  profileId         String
  clientId          String
  sequenceId        String?
  number            String
  variableSymbol    String
  constantSymbol    String?
  specificSymbol    String?
  status            InvoiceStatus    @default(DRAFT)
  issueDate         DateTime
  taxableSupplyDate DateTime?
  dueDate           DateTime
  paidAt            DateTime?
  currency          String           @default("CZK") @db.VarChar(3)
  subtotal          Decimal          @default(0) @db.Decimal(12, 2)
  vatTotal          Decimal          @default(0) @db.Decimal(12, 2)
  total             Decimal          @default(0) @db.Decimal(12, 2)
  notes             String?
  /// Snapshot odběratele v době vystavení. Doklad se nesmí měnit,
  /// když se později upraví adresář odběratelů.
  clientName        String           @default("")
  clientStreet      String           @default("")
  clientCity        String           @default("")
  clientPostalCode  String           @default("")
  clientCountry     String           @default("Česká republika")
  clientIco         String?          @db.VarChar(16)
  clientDic         String?          @db.VarChar(20)
  clientEmail       String?
  qrPaymentPayload  String?
  pdfPath           String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items             InvoiceItem[]
  profile           UserProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sequence          InvoiceSequence? @relation(fields: [sequenceId], references: [id], onDelete: SetNull)

  @@unique([profileId, number])
  @@index([clientId])
  @@index([profileId, status])
  @@index([dueDate])
}

model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  position     Int
  name         String
  quantity     Decimal  @db.Decimal(12, 3)
  unit         String   @default("ks")
  unitPrice    Decimal  @db.Decimal(12, 2)
  vatRate      Decimal  @default(0) @db.Decimal(5, 2)
  lineSubtotal Decimal  @db.Decimal(12, 2)
  lineVat      Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal    Decimal  @db.Decimal(12, 2)
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceAsset {
  id          String           @id @default(cuid())
  profileId   String
  type        InvoiceAssetType
  fileName    String
  mimeType    String
  storagePath String
  createdAt   DateTime         @default(now())
  profile     UserProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, type])
}

model Project {
  id          String        @id @default(cuid())
  profileId   String
  /// Projekt může být i interní, proto je odběratel volitelný.
  clientId    String?
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  priority    Priority      @default(MEDIUM)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  profile     UserProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([profileId, status])
  @@index([clientId])
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  /// Pořadí uvnitř sloupce nástěnky.
  position    Int        @default(0)
  dueDate     DateTime?
  doneAt      DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  notes       TaskNote[]
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, position])
  @@index([status])
}

model TaskNote {
  id        String   @id @default(cuid())
  taskId    String
  body      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}
